{
  "sourceLanguage": "en",
  "strings": {
    "%@ (PID %@)\nMemory: %@\nCPU: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (PID %@)\nMemory: %@\nCPU: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（PID %2$@）\n内存：%3$@\nCPU：%4$@"
          }
        }
      }
    },
    "%@ freed": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
