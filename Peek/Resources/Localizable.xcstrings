            "value": "警告"
          }
        }
      }
    },
    "Welcome to Peek": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 Peek"
          }
        }
      }
    },
    "When empty, Peek scans ~/Developer, ~/Projects and similar folders.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空时扫描 ~/Developer、~/Projects 等常见目录。"
          }
        }
      }
    },
    "Window State": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口状态"
          }
        }
      }
    },
    "With Full Disk Access Peek can also clean Safari cache and sandboxed app caches, and show the Trash size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "授权后可多清理：Safari 缓存、沙盒 App 缓存，并能显示废纸篓大小。"
          }
        }
      }
    },
    "—": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "—"
          }
        }
      }
    },
    "“%@” will be moved to the Trash. You can restore it from there.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”将移到废纸篓，可从废纸篓恢复。"
          }
        }
      }
    }
