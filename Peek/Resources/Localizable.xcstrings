    "%@ freed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "释放 %@"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，共 %2$@"
          }
        }
      }
    },
    "%@ selected of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
