        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ used · %@ free"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %1$@ · 可用 %2$@"
          }
        }
      }
    },
    "%@ will be moved to the Trash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will be moved to the Trash"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会移到废纸篓"
          }
        }
      }
    },
    "%@ · %@\n\nMake sure you no longer need it. Peek only lists items by size and doesn’t check whether they’re safe to delete.\n\nIt will be moved to the Trash and can be restored until you empty the Trash.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@\n\nMake sure you no longer need it. Peek only lists items by size and doesn’t check whether they’re safe to delete.\n\nIt will be moved to the Trash and can be restored until you empty the Trash."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@\n\n请自己确认这是不再需要的内容。Peek 只按大小列出，不判断能不能删。\n\n会移到废纸篓，清倒废纸篓之前都能恢复。"
          }
        }
      }
    },
    "%@ · %@:%@ (PID %@)\nClick to open http://localhost:%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@:%@ (PID %@)\nClick to open http://localhost:%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@:%3$@（PID %4$@）\n点击打开 http://localhost:%5$@"
          }
        }
      }
    },
