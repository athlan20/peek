        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户缓存"
          }
        }
      }
    },
    "Uses the system tool to rebuild the QuickLook thumbnail cache.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用系统工具重建 QuickLook 的缩略图缓存。"
